# latency.promql — used by tutorial page 3.1 "Latency, three grains"
# Scenario: slow-tool (deep dive: concurrent).
# Question: is the dependency responsible for the slowdown?
#
# Percentiles come from histogram_quantile over the classic _bucket series.
# Cloud Monitoring exposes ADK's dotted histograms as suffixed Prometheus
# series inside the UTF-8 brace form, so every reference is {"<name>_bucket"}
# with the "le" label, never the native {"<name>"} form (which returns zero
# series on this project — Stage 0).
#
# POST each block on its own to:
#   monitoring.googleapis.com/v1/projects/$PROJECT_ID/location/global/prometheus/api/v1/query
# with body  query=<urlencoded>  and an ADC bearer token.
#
# Every selector filters on job="adk-metrics-3-1", the OTEL_SERVICE_NAME page
# 3.1 starts its server with, so no other page's run leaks into the reading.
# Change the job to read another server. The concurrent deep dive uses
# job="adk-metrics-3-1c".

# --- Agent invocation latency, p50 and p95 over the last 10 minutes --------

# p50 of the whole turn (invoke_agent.duration), one line per agent.
histogram_quantile(
  0.50,
  sum by (le, "gen_ai.agent.name") (
    rate({"gen_ai.invoke_agent.duration_bucket", job="adk-metrics-3-1"}[10m])
  )
)

# p95 of the whole turn.
histogram_quantile(
  0.95,
  sum by (le, "gen_ai.agent.name") (
    rate({"gen_ai.invoke_agent.duration_bucket", job="adk-metrics-3-1"}[10m])
  )
)

# --- Model call latency, mean by model -------------------------------------
# client.operation.duration is the model round trip alone. Under adk web it
# comes from the genai instrumentation with OpenTelemetry's default bounds
# (0, 5, 10, 25, ...), so a p95 only says "under 5 s". Read the mean instead.

sum by ("gen_ai.request.model") (
  rate({"gen_ai.client.operation.duration_sum", job="adk-metrics-3-1"}[10m])
)
  /
sum by ("gen_ai.request.model") (
  rate({"gen_ai.client.operation.duration_count", job="adk-metrics-3-1"}[10m])
)

# --- Tool latency, p95 by tool ---------------------------------------------
# Two tools of different latency: get_weather is instant, get_forecast sleeps
# 0.3-1.5 s, so the two names sit in different buckets. This is where the
# slow-tool slowdown shows up.

histogram_quantile(
  0.95,
  sum by (le, "gen_ai.tool.name") (
    rate({"gen_ai.execute_tool.duration_bucket", job="adk-metrics-3-1"}[10m])
  )
)
