# volume.promql — used by tutorial page 3.2 "Volume and shape"
# Scenario: multi-city.
# Question: is repeated work driving latency and consumption?
#
# The _count series of a histogram is a cumulative counter of recorded
# datapoints. rate() over it gives events per second; multiply by 60 for a
# per-minute rate. sum ÷ count gives the mean work per turn.
#
# POST each block to:
#   monitoring.googleapis.com/v1/projects/$PROJECT_ID/location/global/prometheus/api/v1/query
# with body  query=<urlencoded>  and an ADC bearer token.
#
# Every selector filters on job="adk-metrics-3-2", the OTEL_SERVICE_NAME page
# 3.2 starts its server with, so no other page's run leaks into the reading.
# Change the job to read another server.

# --- Turns per minute ------------------------------------------------------
# invoke_agent.duration records once per invocation, so its _count is the turn
# counter. This is the denominator for every per-turn rate below.

sum(rate({"gen_ai.invoke_agent.duration_count", job="adk-metrics-3-2"}[10m])) * 60

# --- Inference calls per turn ----------------------------------------------
# inference_calls sum ÷ invoke_agent count = model calls per turn. A plain
# London turn is 2 (call, tool, call); a three-city turn does more.

sum(rate({"gen_ai.invoke_agent.inference_calls_sum", job="adk-metrics-3-2"}[10m]))
  /
sum(rate({"gen_ai.invoke_agent.inference_calls_count", job="adk-metrics-3-2"}[10m]))

# --- Tool calls per turn ---------------------------------------------------
# tool_calls sum ÷ count = tool invocations per turn. The multi-city turns
# push this above 1.

sum(rate({"gen_ai.invoke_agent.tool_calls_sum", job="adk-metrics-3-2"}[10m]))
  /
sum(rate({"gen_ai.invoke_agent.tool_calls_count", job="adk-metrics-3-2"}[10m]))

# --- The two populations, as a bucket distribution -------------------------
# Buckets are cumulative (each counts every turn at or below its le) and count
# since the server started, so take increase() over the run's window and
# subtract each bucket from the next to get the turns in each range.

sum by (le) (increase({"gen_ai.invoke_agent.tool_calls_bucket", job="adk-metrics-3-2"}[10m]))
