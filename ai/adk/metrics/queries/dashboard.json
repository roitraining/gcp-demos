{
  "displayName": "ADK agent metrics (tutorial 3.5)",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Turn latency p95 (invoke_agent.duration)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, \"gen_ai.agent.name\") (rate({\"gen_ai.invoke_agent.duration_bucket\", job=\"adk-metrics-3-5\"}[10m])))"
                }
              }
            ],
            "yAxis": { "label": "seconds", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Model request duration p50 / p95 (client.operation.duration)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "legendTemplate": "p50 ${'gen_ai.request.model'}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le, \"gen_ai.request.model\") (rate({\"gen_ai.client.operation.duration_bucket\", job=\"adk-metrics-3-5\"}[10m])))"
                }
              },
              {
                "plotType": "LINE",
                "legendTemplate": "p95 ${'gen_ai.request.model'}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, \"gen_ai.request.model\") (rate({\"gen_ai.client.operation.duration_bucket\", job=\"adk-metrics-3-5\"}[10m])))"
                }
              }
            ],
            "yAxis": { "label": "seconds", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tokens per minute by type (client.token.usage)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_AREA",
                "legendTemplate": "${'gen_ai.token.type'}",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (\"gen_ai.token.type\") (rate({\"gen_ai.client.token.usage_sum\", job=\"adk-metrics-3-5\"}[10m])) * 60"
                }
              }
            ],
            "yAxis": { "label": "tokens/min", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Input tokens per model call",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate({\"gen_ai.client.token.usage_sum\", job=\"adk-metrics-3-5\", \"gen_ai.token.type\"=\"input\"}[10m])) / sum(rate({\"gen_ai.client.token.usage_count\", job=\"adk-metrics-3-5\", \"gen_ai.token.type\"=\"input\"}[10m]))"
                }
              }
            ],
            "yAxis": { "label": "tokens/call", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tool latency p95 by tool (execute_tool.duration)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "legendTemplate": "${'gen_ai.tool.name'}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, \"gen_ai.tool.name\") (rate({\"gen_ai.execute_tool.duration_bucket\", job=\"adk-metrics-3-5\"}[10m])))"
                }
              }
            ],
            "yAxis": { "label": "seconds", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Tool error ratio (error.type over all)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate({\"gen_ai.execute_tool.duration_count\", job=\"adk-metrics-3-5\", \"error.type\"=~\".+\"}[10m])) / sum(rate({\"gen_ai.execute_tool.duration_count\", job=\"adk-metrics-3-5\"}[10m]))"
                }
              }
            ],
            "yAxis": { "label": "ratio", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Turns per minute by agent (invoke_agent.duration count)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "legendTemplate": "${'gen_ai.agent.name'}",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (\"gen_ai.agent.name\") (rate({\"gen_ai.invoke_agent.duration_count\", job=\"adk-metrics-3-5\"}[10m])) * 60"
                }
              }
            ],
            "yAxis": { "label": "turns/min", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Model call distribution (client.operation.duration count by model)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "legendTemplate": "${'gen_ai.request.model'}",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (\"gen_ai.request.model\") (rate({\"gen_ai.client.operation.duration_count\", job=\"adk-metrics-3-5\"}[10m])) * 60"
                }
              }
            ],
            "yAxis": { "label": "calls/min", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
