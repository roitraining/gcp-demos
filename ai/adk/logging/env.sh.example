# Copy to env.sh, set your project, then `source env.sh` in each shell you use.
# These are the shell variables the tutorial's gcloud commands and deploy
# scripts read. (The running agent reads its own config from .env / demo_agent/.env.)

export PROJECT_ID=your_project
export GOOGLE_CLOUD_PROJECT=$PROJECT_ID   # the ADK/genai runtime reads this name
export REGION=us-central1
export LOCATION=$REGION
export BUCKET=${PROJECT_ID}-adk-debug
