# Copy to env.sh, set your project, then `source env.sh` in each shell you use.
# These are the shell variables the tutorial's gcloud and curl commands read.
# The running agent reads its own model config from .env / demo_agent/.env.

export PROJECT_ID=your_project
export GOOGLE_CLOUD_PROJECT=$PROJECT_ID   # the ADK/genai runtime reads this name
export REGION=us-central1
export LOCATION=$REGION

# The OpenTelemetry service filter and the Service/workload column in Trace
# Explorer. Set it on every route or a laptop run files under an unknown service.
# adk web --otel_to_cloud and get_gcp_exporters both read it.
export OTEL_SERVICE_NAME=adk-tracing

# The log name the bridged records (Part 3) land under, so 3.3's three streams
# are visibly distinct. Way A defaults to adk-otel without this.
export GOOGLE_CLOUD_DEFAULT_LOG_NAME=$OTEL_SERVICE_NAME
